<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Dominion.DynamicStrategyLoader</RootNamespace>
    <AssemblyName>Dominion.DynamicStrategyLoader</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CodeDom" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed all strategies from BuiltInStrategies as the single source of truth.
         The Link element preserves the EmbeddedStrategies resource name prefix
         so DynamicStrategyLoader.cs requires no changes. -->
    <EmbeddedResource Include="..\BuiltInStrategies\Strategies\*.cs">
      <Link>EmbeddedStrategies\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuiltInStrategies\Dominion.BuiltInStrategies.csproj" />
    <ProjectReference Include="..\Dominion.Strategy\Dominion.Strategy.csproj" />
    <ProjectReference Include="..\Dominion\Dominion.csproj" />
    <ProjectReference Include="..\Resources\Resources.csproj" />
  </ItemGroup>

</Project>
